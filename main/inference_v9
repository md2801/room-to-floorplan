python infer_roomtofp_v9.py `
  --sample-npz "data/roomtofp_polygon_v9_clean/samples/scene_03401.npz" `
  --checkpoint "output/v9/artifacts/best_ema.pt" `
  --output-dir "output/v9_inference/scene_03401" `
  --geometry-source boundary128 `
  --room-threshold 0.45 `
  --mask-threshold 0.50

Raw scene use:
python infer_roomtofp_v9.py `
  --scene-dir "F:/.../Structured3D/scene_03401" `
  --checkpoint "output/v9/artifacts/best_ema.pt" `
