def extract_rooms_from_prediction(
    pred: dict[str, torch.Tensor],
    args: argparse.Namespace,
) -> list[dict[str, Any]]:
    grid_size = int(args.grid_size)

    room_scores = sigmoid_np(pred["room_valid_logits"])[0]
    classes = torch.argmax(pred["room_class_logits"], dim=-1)[0].detach().cpu().numpy()

    corner_valid = sigmoid_np(pred["corner_valid_logits"])[0]
    corner_xy = pred["corner_xy"][0].detach().cpu().numpy().astype(np.float32)

    boundary128 = None
    boundary64 = None
    boundary_point_valid = None

    if "boundary128_xy" in pred:
        boundary128 = pred["boundary128_xy"][0].detach().cpu().numpy().astype(np.float32)

    if "boundary64_xy" in pred:
        boundary64 = pred["boundary64_xy"][0].detach().cpu().numpy().astype(np.float32)

    if "boundary_point_valid_logits" in pred:
        boundary_point_valid = sigmoid_np(pred["boundary_point_valid_logits"])[0]

    room_masks = None
    if "room_mask_logits" in pred:
        room_masks = sigmoid_np(pred["room_mask_logits"])[0]

    rooms: list[dict[str, Any]] = []

    for ridx, score in enumerate(room_scores):
        if float(score) < float(args.room_threshold):
            continue

        cls = int(classes[ridx])
        room_type = ROOM_TYPES[cls] if 0 <= cls < len(ROOM_TYPES) else "other"

        source = str(args.geometry_source)

        if args.geometry_source == "boundary128" and boundary128 is not None:
            pts_norm = boundary128[ridx]

        elif args.geometry_source == "boundary64" and boundary64 is not None:
            pts_norm = boundary64[ridx]

        elif args.geometry_source == "corners":
            keep = corner_valid[ridx] >= float(args.corner_threshold)

            if int(keep.sum()) < 3:
                topk = np.argsort(-corner_valid[ridx])[:4]
                topk = np.sort(topk)
                keep = np.zeros_like(corner_valid[ridx], dtype=bool)
                keep[topk] = True

            pts_norm = corner_xy[ridx, keep]

        elif args.geometry_source == "mask" and room_masks is not None:
            mask_bin = room_masks[ridx] >= float(args.mask_threshold)
            pts_px = largest_contour_polygon(mask_bin.astype(np.uint8), args.simplify_eps_px)

            if pts_px is None:
                continue

            pts_px = clean_pred_polygon(
                points=pts_px,
                grid_size=grid_size,
                simplify_eps_px=args.simplify_eps_px,
                snap_axis_threshold_px=args.snap_axis_threshold_px,
                min_edge_px=args.min_edge_px,
                light_cleanup=not args.no_light_cleanup,
            )

            area = polygon_area_px(pts_px)

            if area < float(args.min_room_area_px):
                continue

            rooms.append(
                {
                    "query_index": int(ridx),
                    "type": room_type,
                    "score": float(score),
                    "class_id": int(cls),
                    "points_px": pts_px.tolist(),
                    "area_px": float(area),
                    "source": "room_mask_logits",
                }
            )

            continue

        else:
            if boundary128 is not None:
                pts_norm = boundary128[ridx]
                source = "boundary128_fallback"
            else:
                keep = corner_valid[ridx] >= float(args.corner_threshold)
                pts_norm = corner_xy[ridx, keep]
                source = "corner_fallback"

        pts_px = np.clip(
            np.round(np.asarray(pts_norm, dtype=np.float32) * float(grid_size - 1)),
            0,
            grid_size - 1,
        ).astype(np.int32)

        if args.geometry_source in {"boundary128", "boundary64"} and boundary_point_valid is not None:
            # Improvement v9: optional dense boundary point filtering
            # By default this is off because boundary128 is trained as a fixed closed sequence
            if args.use_boundary_point_valid:
                valid_points = boundary_point_valid[ridx] >= float(args.boundary_point_threshold)
                valid_points = valid_points[: len(pts_px)]

                if int(valid_points.sum()) >= 8:
                    pts_px = pts_px[valid_points]

        pts_px = clean_pred_polygon(
            points=pts_px,
            grid_size=grid_size,
            simplify_eps_px=args.simplify_eps_px,
            snap_axis_threshold_px=args.snap_axis_threshold_px,
            min_edge_px=args.min_edge_px,
            light_cleanup=not args.no_light_cleanup,
        )

        if len(pts_px) < 3:
            continue

        area = polygon_area_px(pts_px)

        if area < float(args.min_room_area_px):
            continue

        rooms.append(
            {
                "query_index": int(ridx),
                "type": room_type,
                "score": float(score),
                "class_id": int(cls),
                "points_px": pts_px.tolist(),
                "area_px": float(area),
                "source": source,
            }
        )

    if not args.no_overlap_suppression:
        rooms = suppress_overlapping_rooms(
            rooms,
            grid_size=grid_size,
            overlap_threshold=args.room_overlap_threshold,
        )

    rooms = sorted(
        rooms,
        key=lambda r: (float(r.get("score", 0.0)), float(r.get("area_px", 0.0))),
        reverse=True,
    )

    return rooms


# ============================================================
# Opening extraction
# ============================================================

def segment_length(seg: np.ndarray) -> float:
    return float(np.linalg.norm(np.asarray(seg[1], np.float32) - np.asarray(seg[0], np.float32)))


def room_wall_segments(rooms: list[dict[str, Any]], min_length_px: float = 8.0) -> list[dict[str, Any]]:
    segments: list[dict[str, Any]] = []
    seen: set[tuple] = set()

    for room in rooms:
        pts = np.asarray(room["points_px"], dtype=np.float32)

        if len(pts) < 3:
            continue

        for i in range(len(pts)):
            seg = np.asarray([pts[i], pts[(i + 1) % len(pts)]], dtype=np.float32)
            length = segment_length(seg)

            if length < float(min_length_px):
                continue

            key = tuple(sorted([
                tuple(np.round(seg[0] / 4.0).astype(int).tolist()),
                tuple(np.round(seg[1] / 4.0).astype(int).tolist()),
            ]))

            if key in seen:
                continue

            seen.add(key)

            segments.append(
                {
                    "xy": seg.tolist(),
                    "length_px": float(length),
                    "room_type": str(room.get("type", "unknown")),
                    "query_index": int(room.get("query_index", -1)),
                }
            )

    return segments


def point_to_segment_projection(point: np.ndarray, seg: np.ndarray) -> tuple[np.ndarray, float, float]:
    p = np.asarray(point, dtype=np.float32)
    a = np.asarray(seg[0], dtype=np.float32)
    b = np.asarray(seg[1], dtype=np.float32)

    ab = b - a
    denom = float(np.dot(ab, ab))

    if denom <= 1e-8:
        return a.copy(), float(np.linalg.norm(p - a)), 0.0

    t = float(np.dot(p - a, ab) / denom)
    t = max(0.0, min(1.0, t))

    proj = a + t * ab
    dist = float(np.linalg.norm(p - proj))

    return proj, dist, t


def openings_from_mask(
    opening_prob: np.ndarray,
    wall_segments: list[dict[str, Any]],
    args: argparse.Namespace,
) -> list[dict[str, Any]]:
    if not wall_segments:
        return []

    mask = (np.asarray(opening_prob, dtype=np.float32) >= float(args.opening_threshold)).astype(np.uint8)

    if args.opening_clean_close > 1:
        k = np.ones((int(args.opening_clean_close), int(args.opening_clean_close)), dtype=np.uint8)
        mask = cv2.morphologyEx(mask, cv2.MORPH_CLOSE, k)

    num, labels, stats, centroids = cv2.connectedComponentsWithStats(mask, connectivity=8)

    openings: list[dict[str, Any]] = []

    for lab in range(1, num):
        x, y, w, h, area = [int(v) for v in stats[lab]]

        if area < float(args.min_opening_area_px):
            continue

        centroid = np.asarray(centroids[lab], dtype=np.float32)

        best = None
        best_dist = float("inf")
        best_t = 0.0

        for wall in wall_segments:
            proj, dist, t = point_to_segment_projection(
                centroid,
                np.asarray(wall["xy"], dtype=np.float32),
            )

            if dist < best_dist:
                best = wall
                best_dist = dist
                best_t = t

        if best is None or best_dist > float(args.opening_snap_distance_px):
            continue

        wall_seg = np.asarray(best["xy"], dtype=np.float32)
        a = wall_seg[0]
        b = wall_seg[1]
        vec = b - a
        length = float(np.linalg.norm(vec))

        if length <= 1e-6:
            continue

        direction = vec / length

        comp_len = max(float(w), float(h), float(math.sqrt(max(area, 1))))
        open_len = float(np.clip(comp_len * 1.5, args.min_opening_length_px, min(length * 0.75, args.max_opening_length_px)))

        centre_min = open_len / 2.0
        centre_max = max(centre_min, length - open_len / 2.0)
        centre_dist = float(np.clip(best_t * length, centre_min, centre_max))

        centre = a + direction * centre_dist
        p0 = centre - direction * (open_len / 2.0)
        p1 = centre + direction * (open_len / 2.0)

        openings.append(
            {
                "xy": np.asarray([p0, p1], dtype=np.float32).tolist(),
                "length_px": float(open_len),
                "source_area_px": int(area),
                "snap_distance_px": float(best_dist),
                "wall_room_type": str(best.get("room_type", "unknown")),
                "type": "opening",
            }
        )

    return openings


# ============================================================
# Output writers
# ============================================================

def hex_to_rgb(color: str) -> tuple[int, int, int]:
    color = color.strip()

    if color.startswith("#"):
        color = color[1:]

    return tuple(int(color[i:i + 2], 16) for i in (0, 2, 4))


def xml_text(s: str) -> str:
    return str(s).replace("&", "and").replace("<", "").replace(">", "")


def save_mask_png(prob: np.ndarray, path: Path) -> None:
    arr = np.clip(np.asarray(prob, dtype=np.float32), 0.0, 1.0)
    img = Image.fromarray(np.clip(arr * 255.0, 0, 255).astype(np.uint8), mode="L")
    img.save(path)


def save_floorplan_svg(
    rooms: list[dict[str, Any]],
    openings: list[dict[str, Any]],
    path: Path,
    grid_size: int,
    title: str = "RoomToFP v9 prediction",
) -> None:
    lines = []
    lines.append(f'<svg xmlns="http://www.w3.org/2000/svg" width="{grid_size}" height="{grid_size}" viewBox="0 0 {grid_size} {grid_size}">')
    lines.append('<rect x="0" y="0" width="100%" height="100%" fill="white"/>')
    lines.append(f'<title>{xml_text(title)}</title>')

    for room in rooms:
        pts = np.asarray(room["points_px"], dtype=np.float32)

        if len(pts) < 3:
            continue

        room_type = str(room.get("type", "other"))
        color = ROOM_COLORS.get(room_type, ROOM_COLORS["other"])
        points = " ".join([f"{float(x):.1f},{float(y):.1f}" for x, y in pts])
        score = float(room.get("score", 0.0))

        lines.append(
            f'<polygon points="{points}" fill="{color}" fill-opacity="0.55" '
            f'stroke="#222222" stroke-width="2"/>'
        )

        cx = float(pts[:, 0].mean())
        cy = float(pts[:, 1].mean())

        lines.append(
            f'<text x="{cx:.1f}" y="{cy:.1f}" font-size="11" text-anchor="middle" '
            f'fill="#111111">{xml_text(room_type)} {score:.2f}</text>'
        )

    for opening in openings:
        seg = np.asarray(opening["xy"], dtype=np.float32)

        if seg.shape != (2, 2):
            continue

        lines.append(
            f'<line x1="{seg[0, 0]:.1f}" y1="{seg[0, 1]:.1f}" '
            f'x2="{seg[1, 0]:.1f}" y2="{seg[1, 1]:.1f}" '
            f'stroke="#00bcd4" stroke-width="5" stroke-linecap="round"/>'
        )

    lines.append("</svg>")

    path.write_text("\n".join(lines), encoding="utf-8")


def save_floorplan_png(
    rooms: list[dict[str, Any]],
    openings: list[dict[str, Any]],
    path: Path,
    grid_size: int,
) -> None:
    img = Image.new("RGB", (grid_size, grid_size), "white")
    draw = ImageDraw.Draw(img, "RGBA")

    for room in rooms:
        pts = np.asarray(room["points_px"], dtype=np.int32)

        if len(pts) < 3:
            continue

        room_type = str(room.get("type", "other"))
        color = ROOM_COLORS.get(room_type, ROOM_COLORS["other"])
        rgb = hex_to_rgb(color)

        draw.polygon([tuple(p) for p in pts], fill=(*rgb, 140), outline=(30, 30, 30, 255))

        for i in range(len(pts)):
            p0 = tuple(pts[i])
            p1 = tuple(pts[(i + 1) % len(pts)])
            draw.line([p0, p1], fill=(30, 30, 30, 255), width=2)

        cx = int(round(float(pts[:, 0].mean())))
        cy = int(round(float(pts[:, 1].mean())))
        draw.text((cx, cy), room_type, fill=(0, 0, 0, 255), anchor="mm")

    for opening in openings:
        seg = np.asarray(opening["xy"], dtype=np.float32)

        if seg.shape != (2, 2):
            continue

        draw.line(
            [tuple(seg[0]), tuple(seg[1])],
            fill=(0, 188, 212, 255),
            width=5,
        )

    img.save(path)


def save_debug_overlay(
    obs: np.ndarray,
    rooms: list[dict[str, Any]],
    path: Path,
    grid_size: int,
) -> None:
    if obs.shape[-1] >= 8:
        rgb = np.clip(obs[..., 5:8], 0.0, 1.0)
        base = Image.fromarray(np.clip(rgb * 255.0, 0, 255).astype(np.uint8), mode="RGB")
    else:
        base = Image.new("RGB", (grid_size, grid_size), "white")

    base = base.resize((grid_size, grid_size))
    draw = ImageDraw.Draw(base, "RGBA")

    for room in rooms:
        pts = np.asarray(room["points_px"], dtype=np.int32)

        if len(pts) < 3:
            continue

        room_type = str(room.get("type", "other"))
        color = ROOM_COLORS.get(room_type, ROOM_COLORS["other"])
        rgb = hex_to_rgb(color)

        draw.polygon([tuple(p) for p in pts], fill=(*rgb, 70), outline=(255, 0, 0, 255))

    base.save(path)


def save_npz_outputs(
    path: Path,
    pred: dict[str, torch.Tensor],
    obs: np.ndarray,
    rooms: list[dict[str, Any]],
    openings: list[dict[str, Any]],
) -> None:
    out: dict[str, Any] = {
        "observation": obs.astype(np.float32),
        "rooms_json": np.asarray(json.dumps(rooms), dtype=object),
        "openings_json": np.asarray(json.dumps(openings), dtype=object),
    }

    for key in [
        "room_valid_logits",
        "room_class_logits",
        "corner_valid_logits",
        "corner_xy",
        "boundary128_xy",
        "boundary64_xy",
        "boundary_point_valid_logits",
        "room_reference_xy",
        "wall_logits",
        "opening_logits",
        "boundary_logits",
        "corner_heatmap_logits",
        "distance_logits",
        "room_mask_logits",
    ]:
        if key in pred:
            out[key] = pred[key].detach().cpu().numpy()

    np.savez_compressed(path, **out)


# ============================================================
# Main
# ============================================================

def main() -> None:
    ap = argparse.ArgumentParser(description="RoomToFP v9 inference")

    # Inputs
    ap.add_argument("--sample-npz", default=None, help="Path to v9 preprocessed .npz sample")
    ap.add_argument("--scene-dir", default=None, help="Path to raw Structured3D scene_* folder")
    ap.add_argument("--checkpoint", required=True)
    ap.add_argument("--output-dir", required=True)

    # Raw scene BEV settings
    ap.add_argument("--variants", default="full")
    ap.add_argument("--rgb-name", default="rgb_rawlight.png")
    ap.add_argument("--grid-size", type=int, default=512)
    ap.add_argument("--stride", type=int, default=4)
    ap.add_argument("--z-min", type=float, default=-0.5)
    ap.add_argument("--z-max", type=float, default=3.0)
    ap.add_argument("--height-lo", type=float, default=0.15)
    ap.add_argument("--height-hi", type=float, default=1.60)
    ap.add_argument("--xy-padding-m", type=float, default=0.75)
    ap.add_argument("--splat-radius", type=int, default=2)
    ap.add_argument("--corner-prior-sigma", type=float, default=2.5)
    ap.add_argument("--no-furniture-channel", action="store_true")

    # Runtime
    ap.add_argument("--device", default="cuda" if torch.cuda.is_available() else "cpu")
    ap.add_argument("--amp", action="store_true")

    # Extraction
    ap.add_argument(
        "--geometry-source",
        choices=["boundary128", "boundary64", "corners", "mask"],
        default="boundary128",
        help="boundary128 is recommended for v9",
    )
    ap.add_argument("--room-threshold", type=float, default=0.45)
    ap.add_argument("--corner-threshold", type=float, default=0.45)
    ap.add_argument("--mask-threshold", type=float, default=0.50)
    ap.add_argument("--min-room-area-px", type=float, default=80.0)
    ap.add_argument("--room-overlap-threshold", type=float, default=0.65)

    # Light cleanup only
    ap.add_argument("--simplify-eps-px", type=float, default=1.5)
    ap.add_argument("--snap-axis-threshold-px", type=float, default=4.0)
    ap.add_argument("--min-edge-px", type=float, default=4.0)
    ap.add_argument("--no-light-cleanup", action="store_true")
    ap.add_argument("--no-overlap-suppression", action="store_true")

    # Dense boundary point filtering
    ap.add_argument("--use-boundary-point-valid", action="store_true")
    ap.add_argument("--boundary-point-threshold", type=float, default=0.50)

    # Openings
    ap.add_argument("--extract-openings", action="store_true")
    ap.add_argument("--opening-threshold", type=float, default=0.50)
    ap.add_argument("--opening-clean-close", type=int, default=5)
    ap.add_argument("--min-opening-area-px", type=float, default=8.0)
    ap.add_argument("--min-opening-length-px", type=float, default=12.0)
    ap.add_argument("--max-opening-length-px", type=float, default=80.0)
    ap.add_argument("--opening-snap-distance-px", type=float, default=28.0)

    # Saving
    ap.add_argument("--save-raw-npz", action="store_true")
    ap.add_argument("--save-debug-overlay", action="store_true")

    args = ap.parse_args()

    out_dir = Path(args.output_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    obs, input_meta = load_inference_input(args)

    if obs.shape[-1] != 10:
        raise ValueError(f"Expected v9 10-channel input, got {obs.shape}")

    args.grid_size = int(obs.shape[0])

    model, model_info = load_v9_model(args)

    x = torch.from_numpy(obs.transpose(2, 0, 1)).unsqueeze(0).float().to(args.device)

    with torch.no_grad():
        with torch.cuda.amp.autocast(enabled=bool(args.amp and args.device.startswith("cuda"))):
            pred = model(x)

    rooms = extract_rooms_from_prediction(pred, args)

    wall_prob = sigmoid_np(pred["wall_logits"])[0, 0] if "wall_logits" in pred else np.zeros((args.grid_size, args.grid_size), dtype=np.float32)
    opening_prob = sigmoid_np(pred["opening_logits"])[0, 0] if "opening_logits" in pred else np.zeros_like(wall_prob)
    boundary_prob = sigmoid_np(pred["boundary_logits"])[0, 0] if "boundary_logits" in pred else np.zeros_like(wall_prob)
    corner_prob = sigmoid_np(pred["corner_heatmap_logits"])[0, 0] if "corner_heatmap_logits" in pred else np.zeros_like(wall_prob)
    distance_prob = sigmoid_np(pred["distance_logits"])[0, 0] if "distance_logits" in pred else np.zeros_like(wall_prob)

    if "room_mask_logits" in pred:
        room_union_prob = sigmoid_np(pred["room_mask_logits"])[0].max(axis=0)
    else:
        room_union_prob = np.zeros_like(wall_prob)

    openings: list[dict[str, Any]] = []

    if args.extract_openings:
        walls = room_wall_segments(rooms)
        openings = openings_from_mask(opening_prob, walls, args)

    scene_name = str(input_meta.get("scene", "scene"))

    save_floorplan_svg(
        rooms=rooms,
        openings=openings,
        path=out_dir / f"{scene_name}_pred.svg",
        grid_size=args.grid_size,
        title=f"RoomToFP v9 prediction {scene_name}",
    )

    save_floorplan_png(
        rooms=rooms,
        openings=openings,
        path=out_dir / f"{scene_name}_pred.png",
        grid_size=args.grid_size,
    )

    save_mask_png(wall_prob, out_dir / f"{scene_name}_wall_prob.png")
    save_mask_png(opening_prob, out_dir / f"{scene_name}_opening_prob.png")
    save_mask_png(boundary_prob, out_dir / f"{scene_name}_boundary_prob.png")
    save_mask_png(corner_prob, out_dir / f"{scene_name}_corner_heatmap_prob.png")
    save_mask_png(distance_prob, out_dir / f"{scene_name}_distance_prob.png")
    save_mask_png(room_union_prob, out_dir / f"{scene_name}_room_union_prob.png")

    if obs.shape[-1] >= 10:
        save_mask_png(obs[..., 8], out_dir / f"{scene_name}_input_corner_prior.png")
        save_mask_png(obs[..., 9], out_dir / f"{scene_name}_input_distance_to_observed_wall.png")

    if args.save_debug_overlay:
        save_debug_overlay(
            obs=obs,
            rooms=rooms,
            path=out_dir / f"{scene_name}_overlay.png",
            grid_size=args.grid_size,
        )

    if args.save_raw_npz:
        save_npz_outputs(
            path=out_dir / f"{scene_name}_raw_outputs.npz",
            pred=pred,
            obs=obs,
            rooms=rooms,
            openings=openings,
        )

    metadata = {
        "scene": scene_name,
        "input": input_meta,
        "model": model_info,
        "inference_args": vars(args),
        "num_rooms": int(len(rooms)),
        "num_openings": int(len(openings)),
        "rooms": rooms,
        "openings": openings,
        "outputs": {
            "svg": str(out_dir / f"{scene_name}_pred.svg"),
            "png": str(out_dir / f"{scene_name}_pred.png"),
            "wall_prob": str(out_dir / f"{scene_name}_wall_prob.png"),
            "opening_prob": str(out_dir / f"{scene_name}_opening_prob.png"),
            "boundary_prob": str(out_dir / f"{scene_name}_boundary_prob.png"),
            "corner_heatmap_prob": str(out_dir / f"{scene_name}_corner_heatmap_prob.png"),
            "distance_prob": str(out_dir / f"{scene_name}_distance_prob.png"),
            "room_union_prob": str(out_dir / f"{scene_name}_room_union_prob.png"),
        },
    }

    (out_dir / f"{scene_name}_metadata.json").write_text(
        json.dumps(metadata, indent=2),
        encoding="utf-8",
    )

    print(f"[DONE] scene={scene_name}")
    print(f"[DONE] rooms={len(rooms)} openings={len(openings)}")
    print(f"[DONE] output={out_dir}")


if __name__ == "__main__":
    main()