def _state_dict_from_checkpoint(ckpt: Any) -> dict[str, torch.Tensor]:
    if isinstance(ckpt, dict):
        for key in ["model_state_dict", "state_dict", "model"]:
            if key in ckpt and isinstance(ckpt[key], dict):
                return ckpt[key]

    if isinstance(ckpt, dict) and all(isinstance(k, str) for k in ckpt.keys()):
        return ckpt

    raise ValueError("Could not find model_state_dict in checkpoint")


def _checkpoint_args(ckpt: Any) -> dict[str, Any]:
    if isinstance(ckpt, dict) and isinstance(ckpt.get("args"), dict):
        return dict(ckpt["args"])

    return {}


def _infer_model_dims_from_state_dict(state_dict: dict[str, torch.Tensor]) -> dict[str, int]:
    dims: dict[str, int] = {}

    if "room_queries.weight" in state_dict:
        dims["max_rooms"] = int(state_dict["room_queries.weight"].shape[0])
        dims["embed_dim"] = int(state_dict["room_queries.weight"].shape[1])

    if "corner_queries.weight" in state_dict:
        dims["max_corners"] = int(state_dict["corner_queries.weight"].shape[0])

    if "boundary_queries.weight" in state_dict:
        dims["max_boundary_points"] = int(state_dict["boundary_queries.weight"].shape[0])

    for key in ["encoder.stem.0.weight", "backbone.stem.0.weight"]:
        if key in state_dict:
            dims["in_channels"] = int(state_dict[key].shape[1])
            break

    for key, value in state_dict.items():
        if key.endswith("class_head.net.4.bias") or key.endswith("class_head.net.2.bias"):
            dims["room_classes"] = int(value.numel())
            break

    return dims


def load_v9_model(args: argparse.Namespace) -> tuple[RoomToFPPolygonNet, dict[str, Any]]:
    ckpt_path = Path(args.checkpoint)
    ckpt = torch.load(ckpt_path, map_location="cpu")
    state_dict = _state_dict_from_checkpoint(ckpt)
    ckpt_args = _checkpoint_args(ckpt)
    inferred = _infer_model_dims_from_state_dict(state_dict)

    model_cfg = {
        "in_channels": int(inferred.get("in_channels", ckpt_args.get("in_channels", 10))),
        "max_rooms": int(inferred.get("max_rooms", ckpt_args.get("max_rooms", 20))),
        "max_corners": int(inferred.get("max_corners", ckpt_args.get("max_corners", 16))),
        "max_boundary_points": int(inferred.get("max_boundary_points", ckpt_args.get("max_boundary_points", 128))),
        "embed_dim": int(inferred.get("embed_dim", ckpt_args.get("embed_dim", 256))),
        "room_classes": int(inferred.get("room_classes", ckpt_args.get("room_classes", len(ROOM_TYPES)))),
        "dropout": float(ckpt_args.get("dropout", 0.10)),
        "predict_furniture": bool(ckpt_args.get("predict_furniture", False)),
        "base": int(ckpt_args.get("base", 48)),
        "mask_dim": int(ckpt_args.get("mask_dim", ckpt_args.get("mask_dim", 128))),
        "decoder_layers": int(ckpt_args.get("decoder_layers", 4)),
        "corner_decoder_layers": int(ckpt_args.get("corner_decoder_layers", 3)),
        "boundary_decoder_layers": int(ckpt_args.get("boundary_decoder_layers", 3)),
        "num_heads": int(ckpt_args.get("num_heads", 8)),
        "transformer_encoder_layers": int(ckpt_args.get("transformer_encoder_layers", 2)),
        "deform_points": int(ckpt_args.get("deform_points", 4)),
    }

    model = RoomToFPPolygonNet(**model_cfg).to(args.device)

    missing, unexpected = model.load_state_dict(state_dict, strict=False)

    if missing:
        print(f"[WARN] Missing checkpoint keys: {len(missing)}")
        for key in missing[:20]:
            print(f"  missing: {key}")

    if unexpected:
        print(f"[WARN] Unexpected checkpoint keys: {len(unexpected)}")
        for key in unexpected[:20]:
            print(f"  unexpected: {key}")

    model.eval()

    info = {
        "checkpoint": str(ckpt_path),
        "model_cfg": model_cfg,
        "checkpoint_epoch": int(ckpt.get("epoch", -1)) if isinstance(ckpt, dict) else -1,
        "checkpoint_model_version": str(ckpt.get("model_version", "")) if isinstance(ckpt, dict) else "",
        "missing_keys": int(len(missing)),
        "unexpected_keys": int(len(unexpected)),
    }

    return model, info


