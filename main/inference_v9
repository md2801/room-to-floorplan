def load_v9_sample_npz(path: Path) -> tuple[np.ndarray, dict[str, Any]]:
    data = np.load(path, allow_pickle=True)

    if "observation" in data:
        obs = ensure_hwc_observation(data["observation"])
    elif "bev" in data:
        obs = ensure_hwc_observation(data["bev"])
    else:
        raise KeyError(f"{path} has neither observation nor bev")

    if obs.shape[-1] == 8:
        wall = obs[..., 1]
        corner_prior = make_corner_prior_from_observed_wall(wall)
        distance = make_distance_transform(wall)
        obs = build_v9_observation(obs, corner_prior, distance)

    if obs.shape[-1] != 10:
        raise ValueError(f"Expected v9 10-channel observation, got {obs.shape}")

    meta = {
        "source_type": "sample_npz",
        "source_path": str(path),
        "scene": path.stem,
        "available_npz_keys": list(data.files),
        "observation_shape": list(obs.shape),
    }

    for key in ["origin_xy", "meters_per_pixel", "scene"]:
        if key in data:
            try:
                value = data[key]
                if isinstance(value, np.ndarray):
                    value = value.tolist()
                meta[key] = value
            except Exception:
                pass

    return obs.astype(np.float32), meta


def load_v9_scene_dir(args: argparse.Namespace) -> tuple[np.ndarray, dict[str, Any]]:
    scene_dir = Path(args.scene_dir)

    pts, colors, sem, sources = collect_scene_points(
        scene_dir,
        variants=[v.strip() for v in args.variants.split(",") if v.strip()],
        rgb_name=args.rgb_name,
        stride=args.stride,
    )

    bev = make_scene_bev(
        points_xyz=pts,
        semantic=sem,
        colors=colors,
        grid_size=args.grid_size,
        z_clip=(args.z_min, args.z_max),
        height_band_above_floor=(args.height_lo, args.height_hi),
        xy_padding_m=args.xy_padding_m,
        splat_radius=args.splat_radius,
        annotation_xy_m=load_annotation_xy(scene_dir),
    )

    obs8 = stack_roomtofp_observation(bev).astype(np.float32)
    obs8 = ensure_hwc_observation(obs8)

    if args.no_furniture_channel and obs8.shape[-1] >= 5:
        obs8[..., 4] = 0.0

    wall = obs8[..., 1]
    corner_prior = make_corner_prior_from_observed_wall(wall, sigma=args.corner_prior_sigma)
    distance = make_distance_transform(wall)

    obs10 = build_v9_observation(obs8, corner_prior, distance)

    meta = {
        "source_type": "scene_dir",
        "source_path": str(scene_dir),
        "scene": scene_dir.name,
        "observation_shape": list(obs10.shape),
        "num_points": int(len(pts)),
        "num_sources": int(len(sources)) if sources is not None else 0,
        "origin_xy": np.asarray(bev.get("origin_xy", [0.0, 0.0])).tolist(),
        "meters_per_pixel": float(np.asarray(bev.get("meters_per_pixel", [0.0])).reshape(-1)[0]),
    }

    return obs10.astype(np.float32), meta


def load_inference_input(args: argparse.Namespace) -> tuple[np.ndarray, dict[str, Any]]:
    if args.sample_npz:
        return load_v9_sample_npz(Path(args.sample_npz))

    if args.scene_dir:
        return load_v9_scene_dir(args)

    raise ValueError("Provide either --sample-npz or --scene-dir")


# ============================================================
# Polygon helpers
# ============================================================

def polygon_area_px(points: np.ndarray) -> float:
    pts = np.asarray(points, dtype=np.float32)

    if len(pts) < 3:
        return 0.0

    return float(abs(cv2.contourArea(pts)))


def remove_consecutive_duplicate_points(points: np.ndarray, min_dist_px: float = 2.0) -> np.ndarray:
    pts = np.asarray(points, dtype=np.float32)

    if len(pts) < 3:
        return np.round(pts).astype(np.int32)

    cleaned = []

    for p in pts:
        if not cleaned:
            cleaned.append(p)
            continue

        if np.linalg.norm(p - cleaned[-1]) >= float(min_dist_px):
            cleaned.append(p)

    if len(cleaned) >= 2 and np.linalg.norm(cleaned[0] - cleaned[-1]) < float(min_dist_px):
        cleaned.pop()

    if len(cleaned) < 3:
        return np.round(pts).astype(np.int32)

    return np.round(np.asarray(cleaned, dtype=np.float32)).astype(np.int32)


def canonical_winding_no_sort(points: np.ndarray) -> np.ndarray:
    pts = np.asarray(points, dtype=np.float32)

    if len(pts) < 3:
        return np.round(pts).astype(np.int32)

    x = pts[:, 0]
    y = pts[:, 1]

    signed_area = 0.5 * float(np.sum(x * np.roll(y, -1) - y * np.roll(x, -1)))

    if signed_area < 0:
        pts = pts[::-1]

    return np.round(pts).astype(np.int32)


def simplify_polygon(points: np.ndarray, eps_px: float) -> np.ndarray:
    pts = np.asarray(points, dtype=np.int32)

    if len(pts) <= 3 or float(eps_px) <= 0:
        return pts

    approx = cv2.approxPolyDP(
        pts.reshape(-1, 1, 2),
        epsilon=float(eps_px),
        closed=True,
    ).reshape(-1, 2)

    if len(approx) < 3:
        return pts

    return approx.astype(np.int32)


def snap_axis_aligned(points: np.ndarray, threshold_px: float) -> np.ndarray:
    pts = np.asarray(points, dtype=np.float32).copy()

    if len(pts) < 3 or float(threshold_px) <= 0:
        return np.round(pts).astype(np.int32)

    n = len(pts)

    for i in range(n):
        j = (i + 1) % n

        dx = abs(float(pts[j, 0] - pts[i, 0]))
        dy = abs(float(pts[j, 1] - pts[i, 1]))

        if dx <= threshold_px and dy > threshold_px:
            x = 0.5 * (pts[i, 0] + pts[j, 0])
            pts[i, 0] = x
            pts[j, 0] = x

        elif dy <= threshold_px and dx > threshold_px:
            y = 0.5 * (pts[i, 1] + pts[j, 1])
            pts[i, 1] = y
            pts[j, 1] = y

    return np.round(pts).astype(np.int32)


def remove_short_edges(points: np.ndarray, min_edge_px: float = 4.0, max_iters: int = 2) -> np.ndarray:
    pts = np.asarray(points, dtype=np.float32)

    for _ in range(int(max_iters)):
        if len(pts) <= 3:
            break

        keep = np.ones(len(pts), dtype=bool)
        changed = False

        for i in range(len(pts)):
            j = (i + 1) % len(pts)
            edge_len = float(np.linalg.norm(pts[j] - pts[i]))

            if edge_len < float(min_edge_px):
                keep[j] = False
                changed = True

        new_pts = pts[keep]

        if not changed or len(new_pts) < 3:
            break

        pts = new_pts

    return np.round(pts).astype(np.int32)


def clean_pred_polygon(
    points: np.ndarray,
    grid_size: int,
    simplify_eps_px: float,
    snap_axis_threshold_px: float,
    min_edge_px: float,
    light_cleanup: bool = True,
) -> np.ndarray:
    """
    Improvement v9: intentionally light cleanup only

    This preserves the model's predicted sequence and avoids the heavy v7.4 repair stack
    """
    pts = np.asarray(points, dtype=np.float32)

    if len(pts) < 3:
        return np.zeros((0, 2), dtype=np.int32)

    pts = np.clip(np.round(pts), 0, grid_size - 1).astype(np.int32)

    if not light_cleanup:
        return pts

    pts = remove_consecutive_duplicate_points(pts, min_dist_px=2.0)
    pts = canonical_winding_no_sort(pts)
    pts = simplify_polygon(pts, eps_px=simplify_eps_px)
    pts = snap_axis_aligned(pts, threshold_px=snap_axis_threshold_px)
    pts = remove_short_edges(pts, min_edge_px=min_edge_px)

    if len(pts) < 3:
        return np.zeros((0, 2), dtype=np.int32)

    pts = np.clip(pts, 0, grid_size - 1).astype(np.int32)

    return pts


def polygon_to_mask(points: np.ndarray, grid_size: int) -> np.ndarray:
    mask = np.zeros((grid_size, grid_size), dtype=np.uint8)
    pts = np.asarray(points, dtype=np.int32)

    if len(pts) >= 3:
        cv2.fillPoly(mask, [pts], 1)

    return mask


def largest_contour_polygon(mask: np.ndarray, simplify_eps_px: float) -> np.ndarray | None:
    contours, _ = cv2.findContours(
        mask.astype(np.uint8),
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE,
    )

    if not contours:
        return None

    c = max(contours, key=cv2.contourArea)

    if cv2.contourArea(c) < 10:
        return None

    pts = cv2.approxPolyDP(
        c,
        epsilon=max(1.0, float(simplify_eps_px)),
        closed=True,
    ).reshape(-1, 2)

    if len(pts) < 3:
        return None

    return pts.astype(np.int32)


def suppress_overlapping_rooms(
    rooms: list[dict[str, Any]],
    grid_size: int,
    overlap_threshold: float,
) -> list[dict[str, Any]]:
    accepted: list[dict[str, Any]] = []
    occupied = np.zeros((grid_size, grid_size), dtype=np.uint8)

    sorted_rooms = sorted(
        rooms,
        key=lambda r: (float(r.get("score", 0.0)), float(r.get("area_px", 0.0))),
        reverse=True,
    )

    for room in sorted_rooms:
        pts = np.asarray(room["points_px"], dtype=np.int32)

        if len(pts) < 3:
            continue

        mask = polygon_to_mask(pts, grid_size)
        area = float(mask.sum())

        if area <= 0:
            continue

        overlap = float((mask & occupied).sum()) / max(area, 1.0)

        if overlap > float(overlap_threshold):
            continue

        room = dict(room)
        room["overlap_ratio"] = float(overlap)
        accepted.append(room)
        occupied = np.maximum(occupied, mask)

    return accepted


